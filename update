class UniqueKeyLoader(yaml.SafeLoader):
    """YAML loader that rejects duplicate mapping keys."""

    def construct_mapping(self, node, deep=False):
        """Construct a mapping while raising on duplicate keys."""
        mapping = {}
        for key_node, value_node in node.value:
            key = self.construct_object(key_node, deep=deep)
            if key in mapping:
                raise yaml.constructor.ConstructorError(
                    "while constructing a mapping",
                    node.start_mark,
                    f"found duplicate key {key!r}",
                    key_node.start_mark,
                )
            mapping[key] = self.construct_object(value_node, deep=deep)
        return mapping

class UserInterrupt(Exception):
    """Raised when the user requested a clean updater stop."""

    pass

class RunInterrupted(UserInterrupt):
    """Raised with partial results when a normal run is interrupted."""

    def __init__(self, results: list["Result"]):
        """Keep completed step results for history recording."""
        super().__init__()
        self.results = results

def write(*parts):
    """Write to stdout under a lock so spinner updates do not interleave."""
    with _console_lock:
        MAIN_UI.write(*parts)

# ── Spinner thread ────────────────────────────────────────────────────────────

class Spinner:
    """Small TTY-only spinner that redraws a single live line."""

    def __init__(self, render_frame, line_count: int = 1, clear_on_stop: bool = True):
        """Create a spinner using a callback that renders each frame."""
        self.render_frame = render_frame
        self.line_count = line_count
        self.clear_on_stop = clear_on_stop
        self._stop = threading.Event()
        self._idx = 0
        self._started = False
        self._thread = threading.Thread(target=self._loop, daemon=True)

    def _redraw_prefix(self) -> str:
        """Return ANSI movement needed before redrawing the live block."""
        if self.line_count <= 1:
            return MAIN_UI.carriage_return()
        return MAIN_UI.move_up(self.line_count - 1)

    def _clear_prefix(self) -> str:
        """Return ANSI movement needed before clearing the live block."""
        return self._redraw_prefix()

    def _clear_lines(self) -> str:
        """Return ANSI text that clears the whole live block."""
        parts = []
        for idx in range(self.line_count):
            parts.append(MAIN_UI.erase_line())
            if idx < self.line_count - 1:
                parts.append("\n")
        if self.line_count > 1:
            parts.append(MAIN_UI.move_up(self.line_count - 1))
        return "".join(parts)

    def _render_text(self, frame: str) -> str:
        """Render and clear every live line before writing the next frame."""
        lines = self.render_frame(frame).split("\n")
        rendered = []
        for idx, line in enumerate(lines):
            rendered.append(MAIN_UI.erase_line() + line)
            if idx < len(lines) - 1:
                rendered.append("\n")
        return "".join(rendered)

    def _loop(self):
        """Redraw spinner frames until stopped."""
        while not self._stop.is_set():
            frame = SPINNER[self._idx % len(SPINNER)]
            self._idx += 1
            write(self._redraw_prefix(), self._render_text(frame))
            time.sleep(SPIN_INTERVAL)

    def start(self):
        """Start the spinner thread when stdout supports live redraws."""
        if IS_TTY:
            self._started = True
            self._thread.start()

    def stop(self):
        """Stop the spinner thread if it was started."""
        if not IS_TTY or not self._started:
            return
        self._stop.set()
        self._thread.join()
        if self.clear_on_stop:
            write(self._clear_prefix(), self._clear_lines())

def set_active_spinner(spinner):
    """Record the spinner that should be stopped on interrupts."""
    global _active_spinner
    _active_spinner = spinner

def clear_active_spinner():
    """Clear the recorded active spinner."""
    global _active_spinner
    _active_spinner = None

def stop_active_spinner():
    """Stop and clear the recorded active spinner if present."""
    spinner = _active_spinner
    if spinner is not None:
        spinner.stop()
        clear_active_spinner()

def handle_sigint(_signum, _frame):
    """Count Ctrl-C requests without doing unsafe work in the signal handler."""
    global _interrupt_count
    _interrupt_count += 1

def interrupt_requested() -> bool:
    """Return whether the user has requested a stop."""
    return _interrupt_count > 0

def force_interrupt_requested() -> bool:
    """Return whether the user requested a force-stop with a second Ctrl-C."""
    return _interrupt_count > 1

def clear_interrupt_request() -> None:
    """Reset interrupt state before a new top-level run."""
    global _interrupt_count
    _interrupt_count = 0

