# ── Config ────────────────────────────────────────────────────────────────────

def config_error(message: str) -> None:
    """Print a startup configuration error and exit unsuccessfully."""
    write(RED, message, RESET, "\n")
    sys.exit(1)

def ensure_private_dir(path: Path) -> None:
    """Create an owned directory and restrict access to the current user."""
    path.mkdir(parents=True, mode=0o700, exist_ok=True)
    st = path.stat()
    if not statmod.S_ISDIR(st.st_mode):
        config_error(f"Unsafe state path is not a directory: {path}")
    if st.st_uid != os.getuid():
        config_error(f"Unsafe state owner: {path}")
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)

def open_private_lock_file():
    """Open the lock file without truncating it before the lock is held."""
    ensure_private_dir(LOCK_PATH.parent)
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(LOCK_PATH, flags, 0o600)
    except OSError as e:
        config_error(f"Unable to open lock file safely: {e}")
    st = os.fstat(fd)
    if not statmod.S_ISREG(st.st_mode):
        os.close(fd)
        config_error(f"Unsafe lock path is not a regular file: {LOCK_PATH}")
    if st.st_uid != os.getuid():
        os.close(fd)
        config_error(f"Unsafe lock owner: {LOCK_PATH}")
    os.fchmod(fd, 0o600)
    return os.fdopen(fd, "r+")

def open_private_log_file(path: Path):
    """Open a log file with user-only permissions."""
    flags = os.O_CREAT | os.O_RDWR | os.O_TRUNC | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags, 0o600)
    except OSError as e:
        config_error(f"Unable to open log file safely: {e}")
    os.fchmod(fd, 0o600)
    return os.fdopen(fd, "w+")

def acquire_lock():
    """Acquire the singleton update lock or exit if another run is active."""
    lock_file = open_private_lock_file()
    try:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock_file.close()
        write(YELLOW, "Already running\n", RESET)
        sys.exit(1)

    lock_file.seek(0)
    lock_file.truncate()
    lock_file.write(f"{os.getpid()}\n")
    lock_file.flush()
    return lock_file

def check_config_permissions(path: Path) -> None:
    """Reject config files that another user or group could modify."""
    st = path.stat()
    unsafe_writes = statmod.S_IWGRP | statmod.S_IWOTH
    if st.st_uid != os.getuid():
        config_error(f"Unsafe config owner: {path}")
    if st.st_mode & unsafe_writes:
        config_error(f"Unsafe config permissions: {path}")

def read_config_data(path: Path):
    """Read and validate the top-level YAML config mapping."""
    if not path.exists():
        config_error(f"Config not found: {path}")
    check_config_permissions(path)
    try:
        with open(path) as f:
            data = yaml.load(f, Loader=UniqueKeyLoader)  # nosec B506
    except yaml.YAMLError as e:
        config_error(f"Invalid config YAML: {e}")
    if not isinstance(data, dict):
        config_error("Invalid config format")
    return data

def expect_string_list(value, step_name: str, field_name: str, *, allow_empty: bool = True) -> list[str]:
    """Validate a config value that may be one string or a list of strings."""
    if isinstance(value, str):
        items = [value]
    elif isinstance(value, list) and all(isinstance(item, str) and item.strip() for item in value):
        items = value
    else:
        config_error(f"Invalid config for {step_name}: {field_name} must be a string or list of strings")
    if not allow_empty and not items:
        config_error(f"Invalid config for {step_name}: {field_name} must not be empty")
    return items

def expect_string_map(value, step_name: str, field_name: str) -> dict[str, str]:
    """Validate a label-to-command mapping from the config."""
    if not isinstance(value, dict):
        config_error(f"Invalid config for {step_name}: {field_name} must be a map of labels to commands")
    result: dict[str, str] = {}
    for label, cmd in value.items():
        if not isinstance(label, str) or not label.strip() or not isinstance(cmd, str) or not cmd.strip():
            config_error(f"Invalid config for {step_name}: {field_name} entries must be non-empty strings")
        result[label] = cmd
    return result

def parse_stat_block(step_name: str, stat_block) -> tuple[dict[str, str], dict[str, str], str]:
    """Parse before/after/version stat configuration for one step."""
    if not isinstance(stat_block, dict):
        config_error(f"Invalid config for {step_name}: stat must be a map")
    stats_before = expect_string_map(stat_block.get("before", {}), step_name, "stat.before")
    stats_after = expect_string_map(stat_block.get("after", {}), step_name, "stat.after")
    version_cmd = stat_block.get("version", "")
    if "version" in stat_block and (not isinstance(version_cmd, str) or not version_cmd.strip()):
        config_error(f"Invalid config for {step_name}: stat.version must be a non-empty string")
    if version_cmd and (stats_before or stats_after):
        config_error(f"Invalid config for {step_name}: stat.version is exclusive with stat.before/stat.after")
    return stats_before, stats_after, version_cmd

def check_step_keys(section_name: str, name: str, cfg: dict) -> None:
    """Reject unknown step keys so config typos fail fast."""
    unknown = sorted(set(cfg) - STEP_KEYS)
    if unknown:
        allowed = ", ".join(sorted(STEP_KEYS))
        config_error(f"Invalid config for {section_name}.{name}: unknown key {unknown[0]!r}; allowed keys: {allowed}")

def split_command_words(cmd: str) -> list[str]:
    """Split a shell command enough to infer its leading executable."""
    try:
        return shlex.split(cmd, posix=True)
    except ValueError:
        return cmd.split()

def infer_command_needs(cmd: str) -> list[str]:
    """Infer executable needs from the leading command, including sudo target."""
    words = split_command_words(cmd)
    while words and "=" in words[0] and not words[0].startswith(("/", "./")):
        words.pop(0)
    if not words:
        return []
    if words[0] != "sudo":
        return [words[0]]
    needs = ["sudo"]
    rest = [word for word in words[1:] if not word.startswith("-")]
    if rest:
        needs.append(rest[0])
    return needs

def infer_needs(commands: list[str]) -> list[str]:
    """Infer unique executable needs from one or more run commands."""
    needs: list[str] = []
    for cmd in commands:
        for need in infer_command_needs(cmd):
            if need not in needs:
                needs.append(need)
    return needs

def parse_step(section_name: str, name: str, cfg, first: bool) -> Step:
    """Parse one YAML step into a Step dataclass."""
    if not isinstance(cfg, dict):
        config_error(f"Invalid config for {name}: step definition must be a map")
    check_step_keys(section_name, name, cfg)
    if "run" not in cfg:
        config_error(f"Invalid config for {name}: missing run")
    commands = expect_string_list(cfg["run"], name, "run", allow_empty=False)
    needs_explicit = "needs" in cfg
    requires = expect_string_list(cfg["needs"], name, "needs") if needs_explicit else infer_needs(commands)
    skip_if = cfg.get("skip_if", "")
    if not isinstance(skip_if, str):
        config_error(f"Invalid config for {name}: skip_if must be a string")
    stats_before, stats_after, version_cmd = parse_stat_block(name, cfg.get("stat", {}))
    return Step(
        name=name,
        commands=commands,
        section=section_name if first else "",
        group=section_name,
        requires=requires,
        skip_if=skip_if,
        stats_before=stats_before,
        stats_after=stats_after,
        version_cmd=version_cmd,
        needs_explicit=needs_explicit,
    )

def parse_section(section_name: str, entries) -> list[Step]:
    """Parse all steps from one top-level YAML section."""
    if not isinstance(entries, dict):
        config_error(f"Invalid config for section {section_name}: expected a map of step names to step definitions")
    return [parse_step(section_name, name, cfg, idx == 0) for idx, (name, cfg) in enumerate(entries.items())]

def load_config(path: Path) -> list[Step]:
    """Load every update step from the YAML config file."""
    global _empty_sections
    _empty_sections = []
    steps: list[Step] = []
    for section_name, entries in read_config_data(path).items():
        if entries == {}:
            _empty_sections.append(section_name)
        steps.extend(parse_section(section_name, entries))
    if dupes := duplicate_step_names(steps):
        config_error(f"Duplicate step name: {dupes[0]}")
    return steps

def empty_config_sections() -> list[str]:
    """Return empty sections observed during the most recent config load."""
    return list(_empty_sections)

def build_arg_parser() -> argparse.ArgumentParser:
    """Build the command-line parser for updater modes and filters."""
    parser = argparse.ArgumentParser(
        description="Config-driven system updater. With no mode flag, runs selected update steps.",
        epilog="examples: update -l | update -s | update -n --section APT | update -c | update --only 'apt update'",
        allow_abbrev=False,
    )
    modes = parser.add_argument_group("modes", "choose at most one")
    mode = modes.add_mutually_exclusive_group()
    mode.add_argument("-l", "--list-steps", action="store_true", help="list configured step names")
    mode.add_argument("-n", "--dry-run", action="store_true", help="show what would run without updates")
    mode.add_argument("-c", "--check", action="store_true", help="run quick readiness checks")
    mode.add_argument("-t", "--test-config", action="store_true", help="run full config checks")
    mode.add_argument("-s", "--stats", action="store_true", help="show update history statistics")
    mode.add_argument("--self-test", action="store_true", help="run internal non-destructive self-tests")

    filters = parser.add_argument_group("filters", "apply to normal runs and non-stats report modes")
    filters.add_argument("--only", action="append", default=[], metavar="STEP", help="include only this exact step; repeatable")
    filters.add_argument("--skip", action="append", default=[], metavar="STEP", help="exclude this exact step; repeatable")
    filters.add_argument("--section", action="append", default=[], metavar="SECTION", help="include this exact section; repeatable")
    return parser

def parse_cli_args(argv: list[str]) -> CliArgs:
    """Parse argv into the small CliArgs dataclass."""
    ns = build_arg_parser().parse_args(argv)
    return CliArgs(
        dry_run=ns.dry_run,
        check=ns.check,
        test_config=ns.test_config,
        list_steps=ns.list_steps,
        stats=ns.stats,
        self_test=ns.self_test,
        only=ns.only,
        skip=ns.skip,
        section=ns.section,
    )

def known_step_names(steps: list[Step]) -> list[str]:
    """Return known step names in config order."""
    return [step.name for step in steps]

def known_section_names(steps: list[Step]) -> list[str]:
    """Return known section names in first-seen order."""
    names: list[str] = []
    for step in steps:
        if step.group and step.group not in names:
            names.append(step.group)
    return names

def validate_filter_values(steps: list[Step], args: CliArgs) -> None:
    """Ensure filters match exact configured step and section names."""
    step_names = set(known_step_names(steps))
    section_names = set(known_section_names(steps))
    for name in args.only + args.skip:
        if name not in step_names:
            config_error(f"Unknown step filter: {name}. Known: {', '.join(known_step_names(steps))}")
    for section in args.section:
        if section not in section_names:
            config_error(f"Unknown section filter: {section}. Known: {', '.join(known_section_names(steps))}")

def filter_steps(steps: list[Step], args: CliArgs) -> list[Step]:
    """Apply exact --only, --skip, and --section filters while preserving order."""
    validate_filter_values(steps, args)
    selected = steps
    if args.only:
        only = set(args.only)
        selected = [step for step in selected if step.name in only]
    if args.section:
        sections = set(args.section)
        selected = [step for step in selected if step.group in sections]
    if args.skip:
        skipped = set(args.skip)
        selected = [step for step in selected if step.name not in skipped]
    return selected

def filter_reason(step: Step, args: CliArgs) -> str | None:
    """Return why a step is excluded by filters, or None when selected."""
    if args.only and step.name not in set(args.only):
        return "not in --only"
    if args.section and step.group not in set(args.section):
        return "not in --section"
    if args.skip and step.name in set(args.skip):
        return "matched --skip"
    return None

def reap_process(proc, capture_output: bool, timeout: float | None = None) -> str:
    """Wait for a child process and return stdout when it was captured."""
    stdout, _ = proc.communicate(timeout=timeout)
    return stdout or "" if capture_output else ""

def send_process_group(proc, sig: int) -> None:
    """Send a signal to a child process group if it still exists."""
    try:
        os.killpg(proc.pid, sig)
    except ProcessLookupError:
        pass

def terminate_and_reap(proc, capture_output: bool, grace: float = 1.0) -> str:
    """Terminate a child group, escalating to SIGKILL after a grace period."""
    if proc.poll() is not None:
        return reap_process(proc, capture_output)
    send_process_group(proc, signal.SIGTERM)
    try:
        return reap_process(proc, capture_output, timeout=grace)
    except subprocess.TimeoutExpired:
        send_process_group(proc, signal.SIGKILL)
        return reap_process(proc, capture_output)

def should_interrupt_child(protect_on_interrupt: bool) -> bool:
    """Return whether current interrupt state should stop the child now."""
    return interrupt_requested() and (not protect_on_interrupt or force_interrupt_requested())

def poll_command(proc, capture_output: bool, deadline: float | None, protect_on_interrupt: bool) -> CommandResult:
    """Poll a child process while enforcing timeout and interrupt policy."""
    while True:
        if proc.poll() is not None:
            return CommandResult(proc.returncode, reap_process(proc, capture_output))
        if deadline is not None and time.monotonic() >= deadline:
            stdout = terminate_and_reap(proc, capture_output)
            return CommandResult(proc.returncode, stdout, timed_out=True)
        if should_interrupt_child(protect_on_interrupt):
            stdout = terminate_and_reap(proc, capture_output)
            return CommandResult(proc.returncode, stdout, interrupted=True)
        time.sleep(0.1)

def run_shell_command(cmd: str, env: dict, *, log_file=None, capture_output: bool = False,
                      timeout: float | None = None, protect_on_interrupt: bool = False) -> CommandResult:
    """Run a shell command in its own process group with unified controls."""
    # Every command runs in a new process group so parent Ctrl-C handling can
    # decide whether to spare or terminate the child without terminal fan-out.
    stdout = subprocess.PIPE if capture_output else (log_file or subprocess.DEVNULL)
    # Commands are trusted owner-only executable config and intentionally run through a shell.
    proc = subprocess.Popen(  # nosec B603
        [SHELL_PATH, "-c", cmd],
        stdout=stdout, stderr=subprocess.STDOUT,
        text=True, env=env,
        start_new_session=True,
    )
    deadline = time.monotonic() + timeout if timeout is not None else None
    return poll_command(proc, capture_output, deadline, protect_on_interrupt)

def raise_if_interrupted(result: CommandResult) -> None:
    """Convert an interrupted command result into the shared interrupt flow."""
    if result.interrupted:
        raise UserInterrupt()

def missing_requirement(need: str) -> str | None:
    """Return a skip reason when a required executable or file is missing."""
    if "/" in need or need.startswith("~"):
        return None if Path(need).expanduser().exists() else f"{need} not found"
    return None if shutil.which(need) else f"{need} not found"

def skip_reason(step: Step, env: dict) -> str | None:
    """Return the reason a step should be skipped, or None to run it."""
    for need in step.requires:
        if reason := missing_requirement(need):
            return reason
    if step.skip_if:
        result = run_shell_command(step.skip_if, env, timeout=PROBE_TIMEOUT)
        if result.interrupted:
            raise UserInterrupt()
        if result.timed_out:
            return "skip check timed out"
        if result.returncode == 0:
            return "skipped"
    return None

# ── Stat helpers ──────────────────────────────────────────────────────────────

def run_stat_cmd(cmd: str, env: dict) -> str | None:
    """Run one stat command and return its first output line if successful."""
    try:
        result = run_shell_command(cmd, env, capture_output=True, timeout=STAT_TIMEOUT)
        if result.interrupted:
            raise UserInterrupt()
        if result.timed_out or result.returncode != 0:
            return None
        val = result.stdout.strip().split("\n")[0].strip()
        return val or None
    except UserInterrupt:
        raise
    except Exception:
        return None

def run_stats(stats: dict[str, str], env: dict) -> dict[str, str]:
    """Run configured stats and keep only successful values."""
    result: dict[str, str] = {}
    for label, cmd in stats.items():
        val = run_stat_cmd(cmd, env)
        if val is not None:
            result[label] = val
    return result

def build_before_stat_texts(pre_vals: dict[str, str]) -> list[str]:
    """Format before-stat values for display on the live step line."""
    texts: list[str] = []
    for label, val in pre_vals.items():
        display = label.replace("_", " ")
        texts.append(f"{val} {display}")
    return texts

def build_after_stat_parts(post_vals: dict[str, str]) -> list[tuple[str, str]]:
    """Format after-stat values as display parts for final step output."""
    parts: list[tuple[str, str]] = []
    for label, val in post_vals.items():
        display = label.replace("_", " ")
        parts.append(("dot", f"{val} {display}"))
    return parts

def format_elapsed(elapsed: float) -> str:
    """Format elapsed seconds using a stable field width."""
    return f"{elapsed:{ELAPSED_WIDTH}.1f}s"

def prefix_plain(name: str, icon: str = "X") -> str:
    """Return the uncolored prefix used for visual alignment math."""
    return f"  {icon} {format_elapsed(0.0)}  {name}"

def rule_line() -> str:
    """Return the compact separator line used by the UI."""
    return "  " + "─" * RULE_WIDTH + "\n"

def stat_block(stat_texts: list[str] | None = None) -> str:
    """Render aligned gray stat text with dot separators after the first item."""
    texts = stat_texts or []
    if not texts:
        return ""
    return "  " + f" {GRAY}·{RESET} ".join(f"{GRAY}{text}{RESET}" for text in texts)

def strip_ansi(text: str) -> str:
    """Remove terminal color/control sequences for visible-text checks."""
    return ANSI_ESCAPE_RE.sub("", text)

def command_label(cmd: str) -> str:
    """Return a compact label for a shell command."""
    return f"{cmd[:60]}{'…' if len(cmd) > 60 else ''}"

def strip_log_newline(text: str) -> str:
    """Remove line endings while preserving error-output spacing."""
    return text.rstrip("\r\n")

def single_line_excerpt(text: str) -> str:
    """Convert excerpt line breaks for stored reasons without compacting spacing."""
    return " | ".join(text.splitlines())

def command_excerpt(log_file, max_lines: int = 3, max_chars: int = 240) -> str:
    """Extract a tail excerpt from captured command output."""
    log_file.seek(0)
    raw_lines = log_file.readlines()
    if len(raw_lines) >= 2 and raw_lines[1].strip() == "":
        raw_lines = raw_lines[2:]
    lines = [strip_log_newline(line) for line in raw_lines]
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()
    if not lines:
        return ""
    excerpt = "\n".join(lines[-max_lines:])
    return excerpt if len(excerpt) <= max_chars else "…" + excerpt[-(max_chars - 1):]

def clean_fail_excerpt(excerpt: str) -> tuple[str, str | None]:
    """Clean known noisy failure text and extract a referenced log path."""
    log_path = None
    match = re.search(r"log file at (\S+)", excerpt, flags=re.IGNORECASE)
    if match:
        log_path = match.group(1).rstrip(".,)")
        excerpt = re.sub(r",?\s*check log file at \S+ for more details", "", excerpt, flags=re.IGNORECASE)
    return excerpt.strip("\r\n").strip("|,"), log_path

def append_log_detail(details: list[str], log_path: str | Path | None) -> None:
    """Append a log path detail once when one is available."""
    if log_path is not None and not any(detail == f"log: {log_path}" for detail in details):
        details.append(f"log: {log_path}")

def build_fail_info(step_name: str, cmd: str, returncode: int, log_file, log_path: Path | None = None) -> FailureInfo:
    """Build structured failure information from a failed command log."""
    reason = f"{command_label(cmd)} → exit {returncode}"
    excerpt = command_excerpt(log_file)
    details: list[str] = []
    if command_label(cmd) != step_name:
        details.append(f"command: {command_label(cmd)}")
    if excerpt:
        cleaned_excerpt, referenced_log_path = clean_fail_excerpt(excerpt)
        if cleaned_excerpt:
            details.append(cleaned_excerpt)
        append_log_detail(details, referenced_log_path)
        reason += f" ({single_line_excerpt(excerpt)})"
    append_log_detail(details, log_path)
    return FailureInfo(f"exit {returncode}", reason, details)

def build_exception_fail_info(step_name: str, cmd: str, error: Exception, log_path: Path | None = None) -> FailureInfo:
    """Build structured failure information from a Python-side exception."""
    cmd_text = command_label(cmd)
    details = []
    if cmd_text != step_name:
        details.append(f"command: {cmd_text}")
    details.append(str(error).strip("\r\n"))
    if log_path is not None:
        details.append(f"log: {log_path}")
    return FailureInfo("error", f"{cmd_text} → {error}", details)

def wrap_detail_lines(details: list[str], indent: str) -> list[str]:
    """Wrap failure detail lines to fit the current terminal width."""
    width = max(24, MAIN_UI.terminal_width() - len(indent) - 1)
    lines: list[str] = []
    for detail in details:
        for raw_line in detail.splitlines() or [detail]:
            wrapped = textwrap.wrap(
                raw_line,
                width=width,
                break_long_words=False,
                break_on_hyphens=False,
                replace_whitespace=False,
                drop_whitespace=False,
            )
            lines.extend(wrapped or [raw_line])
    return [f"{indent}{GRAY}{line}{RESET}" for line in lines]

def failure_block(name: str, elapsed: float, stats_col: int, failure: FailureInfo) -> str:
    """Render a multi-line failure block aligned with normal step output."""
    prefix = f"  {RED}✗{RESET} {GRAY}{format_elapsed(elapsed)}{RESET}  {name}"
    plain_prefix = prefix_plain(name, "X")
    gap = max(2, stats_col - len(plain_prefix) - 1)
    stat_padding = "  "
    lines = [prefix + (" " * gap) + stat_padding + f"{RED}{failure.summary}{RESET}"]
    if failure.details:
        indent = " " * (len(plain_prefix) + gap + len(stat_padding))
        lines.extend(wrap_detail_lines(failure.details, indent))
    return "\n".join(lines)

def waiting_network_line(icon: str = SPINNER[0], elapsed: float = 0.0) -> str:
    """Render the startup network-wait spinner line."""
    return f"  {YELLOW}{icon}{RESET} {GRAY}{format_elapsed(elapsed)}{RESET}  {YELLOW}Waiting for network{RESET}"

def step_name_color() -> str:
    """Return default white or solid yellow after an interrupt request."""
    return YELLOW if interrupt_requested() else WHITE

def network_check_enabled(env: dict = os.environ) -> bool:
    """Return whether the startup connectivity gate is enabled."""
    value = env.get("UPDATE_NETWORK_CHECK", "1").strip().lower()
    return value not in {"0", "false", "no", "off"}

def parse_network_endpoint(value: str) -> tuple[str, int] | None:
    """Parse host:port or URL-like endpoint text into a socket target."""
    text = value.strip()
    if not text:
        return None
    parsed = urllib.parse.urlparse(text if "://" in text else f"//{text}")
    hostname = parsed.hostname
    if not hostname:
        return None
    try:
        port = parsed.port
    except ValueError:
        return None
    if port:
        return hostname, port
    default_ports = {"http": 80, "https": 443}
    if parsed.scheme in default_ports:
        return hostname, default_ports[parsed.scheme]
    return None

def configured_network_endpoints(env: dict = os.environ) -> tuple[tuple[str, int], ...]:
    """Return user-configured network endpoints or the defaults."""
    raw = env.get("UPDATE_NETWORK_ENDPOINTS", "")
    endpoints = [parsed for item in raw.split(",") if (parsed := parse_network_endpoint(item))]
    return tuple(endpoints) or DEFAULT_NETWORK_ENDPOINTS

def proxy_network_endpoint(env: dict = os.environ) -> tuple[str, int] | None:
    """Return the first proxy endpoint advertised by common proxy env vars."""
    for key in ("HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY", "https_proxy", "http_proxy", "all_proxy"):
        if endpoint := parse_network_endpoint(env.get(key, "")):
            return endpoint
    return None

def network_endpoints(env: dict = os.environ) -> tuple[tuple[str, int], ...]:
    """Return connectivity targets, preferring proxy endpoint when present."""
    endpoints = configured_network_endpoints(env)
    proxy = proxy_network_endpoint(env)
    return (proxy, *endpoints) if proxy else endpoints

def network_up(timeout: float = NETWORK_TIMEOUT, endpoints: tuple[tuple[str, int], ...] | None = None) -> bool:
    """Return whether any connectivity endpoint accepts a TCP connection."""
    endpoints = endpoints or DEFAULT_NETWORK_ENDPOINTS
    for host, port in endpoints:
        try:
            with socket.create_connection((host, port), timeout=timeout):
                return True
        except OSError:
            continue
    return False

def wait_for_network(env: dict = os.environ) -> None:
    """Wait at startup until connectivity is available or the user interrupts."""
    if not network_check_enabled(env):
        return

    endpoints = network_endpoints(env)
    if network_up(endpoints=endpoints):
        return

    t0 = time.monotonic()
    spinner = Spinner(lambda frame: waiting_network_line(frame, time.monotonic() - t0))
    try:
        if IS_TTY:
            write(waiting_network_line(elapsed=0.0))
            spinner.start()
            set_active_spinner(spinner)
        else:
            write(f"  {YELLOW}Waiting for network{RESET}\n")

        while True:
            if interrupt_requested():
                raise UserInterrupt()
            if network_up(endpoints=endpoints):
                break
            time.sleep(1)
    finally:
        stop_active_spinner()
        if IS_TTY:
            write(LINE_CLEAR)

def result_counts(results: list[Result]) -> dict[str, int]:
    """Count completed result statuses for live and final summaries."""
    counts = {"ok": 0, "fail": 0, "skip": 0}
    for result in results:
        counts[result.status] += 1
    return counts

def completed_rule(done: int, total: int) -> str:
    """Render the advancing bottom rule for completed steps."""
    filled = round((done / total) * RULE_WIDTH) if total else 0
    filled = max(0, min(RULE_WIDTH, filled))
    return "  " + GREEN + ("━" * filled) + GRAY + ("─" * (RULE_WIDTH - filled)) + RESET

def progress_rule(progress: ProgressState) -> str:
    """Render the live advancing bottom rule."""
    return completed_rule(len(progress.results), progress.total_steps)

def elapsed_estimate_text(elapsed: float, estimate: float | None) -> str:
    """Render elapsed time and optional estimate without extra labels."""
    if estimate is None:
        return f"{elapsed:.0f}s"
    return f"{elapsed:.0f}s/{estimate:.0f}s"

def gray_rule() -> str:
    """Render the final neutral footer rule."""
    return "  " + GRAY + ("─" * RULE_WIDTH) + RESET

def progress_status(progress: ProgressState) -> str:
    """Render live completed count and elapsed/estimated time."""
    elapsed = time.monotonic() - progress.run_start
    parts = [
        f"{len(progress.results)}/{progress.total_steps}",
        elapsed_estimate_text(elapsed, progress.total_estimate),
    ]
    return "  " + f"  {GRAY}·{RESET}  ".join(f"{GRAY}{part}{RESET}" for part in parts)

def summary_status(results: list[Result], total_steps: int, total: float, estimate: float | None) -> str:
    """Render final counts and actual/estimated time using footer format."""
    counts = result_counts(results)
    parts = []
    if counts["ok"]:
        parts.append(f"{GREEN}{BOLD}{counts['ok']} passed{RESET}")
    if counts["skip"]:
        parts.append(f"{YELLOW}{counts['skip']} skipped{RESET}")
    if counts["fail"]:
        parts.append(f"{RED}{BOLD}{counts['fail']} failed{RESET}")
    parts.append(f"{GRAY}{elapsed_estimate_text(total, estimate)}{RESET}")
    return "  " + f"  {GRAY}·{RESET}  ".join(parts)

def progress_footer(progress: ProgressState | None) -> str:
    """Render the live bottom rule and status block."""
    if progress is None:
        return ""
    return progress_rule(progress) + "\n" + progress_status(progress)

def running_line(name: str, stats_col: int, stat_texts: list[str] | None = None,
                 icon: str = SPINNER[0], elapsed: float = 0.0) -> str:
    """Render the live in-progress step line."""
    prefix = f"  {CYAN}{icon}{RESET} {GRAY}{format_elapsed(elapsed)}{RESET}  {step_name_color()}{BOLD}{name}{RESET}"
    plain_prefix = prefix_plain(name, icon)
    if not stat_texts:
        return prefix
    gap = max(2, stats_col - len(plain_prefix) - 1)
    return prefix + (" " * gap) + stat_block(stat_texts)

def live_step_block(name: str, stats_col: int, stat_texts: list[str], progress: ProgressState | None,
                    icon: str = SPINNER[0], elapsed: float = 0.0) -> str:
    """Render active step plus live footer when progress is available."""
    line = running_line(name, stats_col, stat_texts, icon=icon, elapsed=elapsed)
    footer = progress_footer(progress)
    return line + ("\n" + footer if footer else "")

def render_cleared_lines(lines: list[str]) -> str:
    """Render lines while clearing any old terminal content first."""
    return "\n".join(MAIN_UI.erase_line() + line for line in lines)

def completed_progress(progress: ProgressState, result: Result) -> ProgressState:
    """Return progress state including the newly completed result."""
    return ProgressState(
        min(progress.step_index + 1, progress.total_steps + 1),
        progress.total_steps,
        progress.run_start,
        [*progress.results, result],
        progress.total_estimate,
    )

def section_heading_line(section: str) -> str:
    """Render a section heading without a trailing newline."""
    return f"{BOLD}{SECTION_COLOR}  {section}{RESET}"

def final_line(icon: str, color: str, name: str, elapsed: float, stats_col: int,
               pre_texts: list[str], after_parts: list[tuple[str, str]]) -> str:
    """Render the final ok/failure-compatible line with merged stats."""
    prefix = f"  {color}{icon}{RESET} {GRAY}{format_elapsed(elapsed)}{RESET}  {name}"
    plain_prefix = prefix_plain(name, "X")
    parts = []
    if pre_texts:
        parts.append(pre_texts[0])
        parts.extend(pre_texts[1:])
    for mode, text in after_parts:
        if mode == "dot":
            parts.append(text)
        elif mode == "transition":
            if parts:
                parts[-1] = parts[-1] + f" → {text}"
            else:
                parts.append(f"→ {text}")
        elif mode == "append":
            if parts:
                parts[-1] = parts[-1] + f" {text}"
            else:
                parts.append(text)
    if not parts:
        return prefix
    gap = max(2, stats_col - len(plain_prefix) - 1)
    return prefix + (" " * gap) + stat_block(parts)

# ── Line helpers ──────────────────────────────────────────────────────────────

def skip_line(name: str, reason: str, stats_col: int) -> str:
    """Render a skipped step with the reason aligned to the stats column."""
    prefix = f"  {YELLOW}−{RESET}   {GRAY}{name}{RESET}"
    plain_prefix = f"  -   {name}"
    gap = max(2, stats_col - len(plain_prefix) - 1)
    return prefix + (" " * gap) + stat_block([reason])

def safe_filename(text: str) -> str:
    """Return a filesystem-safe fragment for generated log files."""
    name = re.sub(r"[^A-Za-z0-9_.-]+", "-", text)
    name = re.sub(r"-{2,}", "-", name)
    return name.strip("-._") or "step"

def unwrap_shell_command(cmd: str) -> str:
    """Return the inner command for simple sh/bash -c wrappers."""
    try:
        tokens = shlex.split(cmd)
    except ValueError:
        return cmd
    if not tokens or Path(tokens[0]).name not in {"sh", "bash"}:
        return cmd
    for idx, token in enumerate(tokens[:-1]):
        if token == "-c":
            return tokens[idx + 1]
    return cmd

def strip_sudo_tokens(tokens: list[str]) -> list[str]:
    """Remove a leading sudo wrapper from command tokens."""
    if not tokens or Path(tokens[0]).name != "sudo":
        return tokens
    tokens = tokens[1:]
    idx = 0
    while idx < len(tokens) and tokens[idx].startswith("-"):
        option = tokens[idx]
        idx += 1
        if option in {"-u", "-g", "-h", "-p", "-C", "-T"} and idx < len(tokens):
            idx += 1
    return tokens[idx:]

def command_name_stop_token(token: str) -> bool:
    """Return whether a shell token is not part of the command name."""
    return bool(token in {"|", "&&", "||", ";", "tee"} or re.match(r"^\d*[<>]", token) or token.startswith((">", "<")))

def command_name_for_log(cmd: str) -> str:
    """Derive a compact, meaningful command name for log filenames."""
    for segment in re.split(r"\s*(?:&&|\|\||;|\|)\s*", unwrap_shell_command(cmd)):
        try:
            tokens = shlex.split(segment)
        except ValueError:
            tokens = segment.split()
        tokens = strip_sudo_tokens(tokens)
        while tokens and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", tokens[0]):
            tokens = tokens[1:]
        if not tokens or tokens[0] in {"source", ".", "true"}:
            continue
        parts = [Path(tokens[0]).name]
        option_parts: list[str] = []
        for token in tokens[1:]:
            if command_name_stop_token(token):
                break
            if token.startswith("-"):
                option_parts.append(token.lstrip("-"))
                continue
            parts.append(Path(token).name)
            if len(parts) >= 3:
                break
        if len(parts) == 1 and option_parts:
            parts.append(option_parts[0])
        return safe_filename("-".join(parts))
    return safe_filename(command_label(cmd))

def timestamped_log_dir_name(now: datetime) -> str:
    """Return the compact timestamp used for one retained log directory."""
    return now.astimezone().strftime("%Y%m%d-%H%M%S")

def create_log_dir(now: datetime | None = None) -> Path:
    """Create and return a retained per-run command log directory."""
    ensure_private_dir(LOG_ROOT)
    base_name = timestamped_log_dir_name(now or datetime.now().astimezone())
    counter = 1
    while True:
        suffix = "" if counter == 1 else f"-{counter}"
        path = LOG_ROOT / f"{base_name}{suffix}"
        try:
            path.mkdir(mode=0o700)
            return path
        except FileExistsError:
            counter += 1

def command_log_temp_path(log_dir: Path, index: int) -> Path:
    """Return the temporary path used while a command is running."""
    return log_dir / f".command-{index + 1:02d}.running.log"

def command_log_status(result: CommandResult) -> str:
    """Return the status suffix for a completed command log."""
    if result.interrupted:
        return "interrupted"
    if result.timed_out:
        return "timeout"
    return "success" if result.returncode == 0 else "failed"

def command_log_path(log_dir: Path, cmd: str, status: str, display_name: str | None = None) -> Path:
    """Return a unique final log path for a command and status."""
    name = safe_filename(display_name) if display_name else command_name_for_log(cmd)
    counter = 1
    while True:
        suffix = "" if counter == 1 else f"-{counter}"
        path = log_dir / f"{name}{suffix}-{safe_filename(status)}.log"
        if not path.exists():
            return path
        counter += 1

def write_command_log_header(log_file, cmd: str) -> None:
    """Write the exact shell command before captured command output."""
    log_file.write(f"{cmd}\n\n")
    log_file.flush()

def finalize_command_log(temp_path: Path, log_dir: Path, cmd: str, status: str, display_name: str | None = None) -> Path:
    """Rename a temporary command log to its final status-bearing path."""
    final_path = command_log_path(log_dir, cmd, status, display_name)
    try:
        temp_path.replace(final_path)
    except OSError as e:
        config_error(f"Unable to finalize log file safely: {e}")
    return final_path

def open_private_append_file(path: Path):
    """Open an append-only private state file."""
    ensure_private_dir(path.parent)
    flags = os.O_CREAT | os.O_WRONLY | os.O_APPEND | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags, 0o600)
    except OSError as e:
        config_error(f"Unable to open state file safely: {e}")
    st = os.fstat(fd)
    if not statmod.S_ISREG(st.st_mode):
        os.close(fd)
        config_error(f"Unsafe state path is not a regular file: {path}")
    if st.st_uid != os.getuid():
        os.close(fd)
        config_error(f"Unsafe state owner: {path}")
    os.fchmod(fd, 0o600)
    return os.fdopen(fd, "a")

def step_history_key(step_or_result) -> str:
    """Return the stable history key for a configured or completed step."""
    group = getattr(step_or_result, "group", "")
    name = getattr(step_or_result, "name", "")
    return f"{group}/{name}" if group else name

def read_history() -> list[dict]:
    """Read append-only run history records, skipping corrupt lines."""
    records: list[dict] = []
    try:
        with open(HISTORY_PATH) as f:
            for line in f:
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if isinstance(record, dict):
                    records.append(record)
    except Exception:
        return []
    return records

def write_history(record: dict) -> None:
    """Append one run record to the JSONL history file."""
    with open_private_append_file(HISTORY_PATH) as f:
        json.dump(record, f, sort_keys=True)
        f.write("\n")

def history_step_records(history: list[dict], key: str) -> list[dict]:
    """Return historical per-step records matching a stable step key."""
    records: list[dict] = []
    for run in history:
        steps = run.get("steps", [])
        if not isinstance(steps, list):
            continue
        records.extend(step for step in steps if isinstance(step, dict) and step.get("key") == key)
    return records

def estimate_step_duration(step: Step, history: list[dict]) -> float | None:
    """Return average successful duration for a step from JSONL history."""
    entries = [item for item in history_step_records(history, step_history_key(step)) if item.get("status") == "ok"]
    values = [float(item["elapsed"]) for item in entries if isinstance(item.get("elapsed"), (int, float))]
    return sum(values) / len(values) if values else None

def estimate_total_duration(steps: list[Step], history: list[dict]) -> float | None:
    """Return estimated total duration for selected steps when known."""
    values = [value for step in steps if (value := estimate_step_duration(step, history)) is not None]
    return sum(values) if values else None

def estimate_complete_total_duration(steps: list[Step], history: list[dict]) -> float | None:
    """Return total estimate only when every selected step has history."""
    values: list[float] = []
    for step in steps:
        value = estimate_step_duration(step, history)
        if value is None:
            return None
        values.append(value)
    return sum(values) if values else None

def history_step_record(result: Result) -> dict:
    """Convert a completed step result into a history JSON object."""
    return {
        "key": step_history_key(result),
        "section": result.group,
        "name": result.name,
        "status": result.status,
        "elapsed": round(result.elapsed, 3),
        "reason": result.reason,
    }

def build_history_record(results: list[Result], started_at: datetime, ended_at: datetime,
                         elapsed: float, status: str) -> dict:
    """Build one append-only run history record."""
    return {
        "schema": 1,
        "run_id": f"{started_at:%Y%m%d-%H%M%S}-{os.getpid()}",
        "status": status,
        "started_at": started_at.astimezone().isoformat(timespec="seconds"),
        "ended_at": ended_at.astimezone().isoformat(timespec="seconds"),
        "elapsed": round(elapsed, 3),
        "steps": [history_step_record(result) for result in results],
    }

def record_history(results: list[Result], started_at: datetime, ended_at: datetime,
                   elapsed: float, *, status: str = "completed") -> None:
    """Append one normal-run history record."""
    write_history(build_history_record(results, started_at, ended_at, elapsed, status))

# ── Stats ─────────────────────────────────────────────────────────────────────

def coerce_float(value, default: float = 0.0) -> float:
    """Return value as float, or a safe default."""
    try:
        return float(value)
    except (TypeError, ValueError):
        return default

def parse_history_datetime(value) -> datetime | None:
    """Parse an ISO history timestamp."""
    if not isinstance(value, str):
        return None
    try:
        return datetime.fromisoformat(value)
    except ValueError:
        return None

def stats_run_status(record: dict, steps: list[dict]) -> str:
    """Return completed, interrupted, or failed for a history run."""
    raw = str(record.get("status") or "completed")
    if raw == "interrupted":
        return raw
    if raw == "failed" or any(step.get("status") == "fail" for step in steps):
        return "failed"
    return "completed"

def stats_runs_from_history(history: list[dict]) -> list[StatsRun]:
    """Convert raw JSON history records into validated stats runs."""
    runs: list[StatsRun] = []
    for record in history:
        started = parse_history_datetime(record.get("started_at"))
        if started is None:
            continue
        steps = [step for step in record.get("steps", []) if isinstance(step, dict)]
        elapsed = coerce_float(record.get("elapsed"), sum(coerce_float(step.get("elapsed")) for step in steps))
        runs.append(StatsRun(started, elapsed, stats_run_status(record, steps), steps))
    return sorted(runs, key=lambda run: run.started_at)

def stats_range_days(label: str) -> int | None:
    """Return the rolling day count for a stats range label."""
    for name, days in STATS_RANGES:
        if name == label:
            return days
    return None

def filter_stats_runs(runs: list[StatsRun], label: str, now: datetime | None = None) -> list[StatsRun]:
    """Filter runs to All, rolling Week, or rolling Month."""
    days = stats_range_days(label)
    if days is None:
        return list(runs)
    now = now or datetime.now().astimezone()
    cutoff = now.timestamp() - (days * 86400)
    return [run for run in runs if run.started_at.timestamp() >= cutoff]

def stats_step_key(step: dict) -> str:
    """Return the stable key for a history step record."""
    key = step.get("key")
    if isinstance(key, str) and key:
        return key
    section = str(step.get("section") or "")
    name = str(step.get("name") or "")
    return f"{section}/{name}" if section else name

def step_average(step: StepStats) -> float:
    """Return the average successful duration for one step aggregate."""
    return step.total_elapsed / step.timed if step.timed else 0.0

def aggregate_step_stats(runs: list[StatsRun]) -> list[StepStats]:
    """Aggregate per-step timing and status counts from runs."""
    by_key: dict[str, StepStats] = {}
    for run in runs:
        for item in run.steps:
            key = stats_step_key(item)
            if not key:
                continue
            section = str(item.get("section") or key.split("/", 1)[0])
            name = str(item.get("name") or key.rsplit("/", 1)[-1])
            step = by_key.setdefault(key, StepStats(key, section, name))
            status = str(item.get("status") or "")
            step.seen += 1
            if status == "ok":
                elapsed = coerce_float(item.get("elapsed"))
                step.ok += 1
                step.timed += 1
                step.total_elapsed += elapsed
            elif status == "skip":
                step.skip += 1
            elif status == "fail":
                step.fail += 1
            step.latest_status = status or step.latest_status
    return sorted(by_key.values(), key=lambda step: (step_average(step), step.total_elapsed), reverse=True)

def run_status_counts(runs: list[StatsRun]) -> dict[str, int]:
    """Count run-level statuses."""
    counts = {"completed": 0, "interrupted": 0, "failed": 0}
    for run in runs:
        counts[run.status] = counts.get(run.status, 0) + 1
    return counts

def step_status_counts(runs: list[StatsRun]) -> dict[str, int]:
    """Count step-level statuses."""
    counts = {"ok": 0, "skip": 0, "fail": 0}
    for run in runs:
        for step in run.steps:
            status = step.get("status")
            if status in counts:
                counts[status] += 1
    return counts

def active_day_count(runs: list[StatsRun]) -> int:
    """Return number of distinct days with at least one run."""
    return len({run.started_at.date() for run in runs})

def total_elapsed(runs: list[StatsRun]) -> float:
    """Return total elapsed seconds for runs."""
    return sum(run.elapsed for run in runs)

def format_stats_duration(seconds: float) -> str:
    """Render seconds as a compact stats duration."""
    seconds = max(0.0, seconds)
    if seconds < 60:
        return f"{seconds:.0f}s"
    if seconds < 3600:
        return f"{seconds / 60:.1f}m"
    return f"{seconds / 3600:.1f}h"

def stats_status_style(status: str) -> str:
    """Return a Rich/Textual style name for a run or step status."""
    code = STATUS_COLOR_CODES.get(status)
    return rgb_hex(xterm_rgb(code)) if code is not None else "dim"

def stats_status_plot_color(status: str):
    """Return a plotext-compatible color for a run status."""
    code = STATUS_COLOR_CODES.get(status)
    return xterm_rgb(code) if code is not None else "gray"

def stats_bar_text(value: float, max_value: float, width: int) -> str:
    """Return a solid block bar suitable for Rich table cells."""
    width = max(1, width)
    filled = round((value / max_value) * width) if max_value > 0 else 0
    filled = max(0, min(width, filled))
    return "█" * filled

def stats_chart_ticks(max_value: float) -> list[float]:
    """Return readable y-axis ticks for the runs chart."""
    target_intervals = 5
    raw_step = max(1.0, max_value) / target_intervals
    magnitude = 1.0
    while magnitude * 10 <= raw_step:
        magnitude *= 10
    step = magnitude * 10
    for factor in (1, 2, 3, 4, 5, 6, 10):
        candidate = magnitude * factor
        if candidate >= raw_step:
            step = candidate
            break
    return [idx * step for idx in range(target_intervals + 1)]

def stats_plain_lines(runs: list[StatsRun]) -> list[str]:
    """Build the non-TTY stats summary."""
    if not runs:
        return ["No update history yet"]
    lines = ["System Update Stats"]
    now = datetime.now().astimezone()
    for label, _days in STATS_RANGES:
        selected = filter_stats_runs(runs, label, now)
        if not selected:
            lines.append(f"{label}: no runs")
            continue
        run_counts = run_status_counts(selected)
        step_counts = step_status_counts(selected)
        steps = aggregate_step_stats(selected)
        slowest = steps[0] if steps else None
        avg = total_elapsed(selected) / len(selected)
        latest = selected[-1]
        parts = [
            f"{len(selected)} runs",
            f"{active_day_count(selected)} active days",
            f"{format_stats_duration(total_elapsed(selected))} total",
            f"{format_stats_duration(avg)} avg",
            f"completed {run_counts.get('completed', 0)}",
            f"interrupted {run_counts.get('interrupted', 0)}",
            f"failed {run_counts.get('failed', 0)}",
            f"steps ok/skip/fail {step_counts['ok']}/{step_counts['skip']}/{step_counts['fail']}",
            f"latest {latest.status} {format_stats_duration(latest.elapsed)}",
        ]
        if slowest:
            parts.append(f"slowest avg {slowest.name} {format_stats_duration(step_average(slowest))}")
        lines.append(f"{label}: " + " · ".join(parts))
    return lines

def print_stats_plain(runs: list[StatsRun]) -> int:
    """Print the static stats summary for non-interactive output."""
    write("\n".join(stats_plain_lines(runs)), "\n")
    return 0

def heatmap_counts(runs: list[StatsRun]) -> dict[object, int]:
    """Return run counts keyed by local date."""
    counts: dict[object, int] = {}
    for run in runs:
        day = run.started_at.date()
        counts[day] = counts.get(day, 0) + 1
    return counts

def plotext_runs_chart(runs: list[StatsRun], width: int, height: int) -> str:
    """Return a plotext bar chart for run elapsed time."""
    import plotext as plt

    plt.clear_figure()
    plt.theme("clear")
    plt.canvas_color(STATS_BG_RGB)
    plt.axes_color(STATS_BG_RGB)
    plt.ticks_color(STATS_ACCENT_MUTED_RGB)
    plt.grid(False, False)
    plt.frame(True)
    plt.plot_size(max(40, width), max(8, height))
    plt.xlim(0.5, len(runs) + 0.5)
    max_elapsed = max((run.elapsed for run in runs), default=0.0)
    y_ticks = stats_chart_ticks(max_elapsed)
    plt.ylim(0, y_ticks[-1])
    plt.yticks(y_ticks, [format_stats_duration(value) for value in y_ticks])
    if len(runs) == 1:
        plt.xticks([1], ["1"])
    else:
        x_ticks = sorted({1, (len(runs) + 1) // 2, len(runs)})
        plt.xticks(x_ticks, [str(value) for value in x_ticks])
    for idx, run in enumerate(runs, start=1):
        plt.bar([idx], [run.elapsed], marker="sd", color=stats_status_plot_color(run.status), fill=True, width=0.86)
    return plt.build()

def stats_tui_missing_dependency(error: Exception) -> None:
    """Exit with the configured styled error for missing stats TUI libraries."""
    missing = getattr(error, "name", "textual or plotext")
    config_error(f"Stats require {', '.join(STATS_TUI_DEPENDENCIES)} ({missing} missing)")

def run_stats_tui(runs: list[StatsRun]) -> int:
    """Run the Textual interactive stats dashboard."""
    try:
        from textual.app import App, ComposeResult
        from textual.binding import Binding
        from textual.widgets import Static
        __import__("plotext")
    except ImportError as e:
        stats_tui_missing_dependency(e)

    class StatsApp(App):
        """Textual dashboard for update history stats."""

        CSS = f"""
        Screen {{ background: {STATS_BG}; color: #d8dee9; }}
        #stats {{ width: 100%; height: 1fr; padding: 1 2; }}
        """
        ENABLE_COMMAND_PALETTE = False
        COMMAND_PALETTE_BINDING = None
        BINDINGS = [Binding("left", "previous_page", "page", show=False), Binding("right", "next_page", "page", show=False), Binding("up", "previous_range", "range", show=False), Binding("down", "next_range", "range", show=False), Binding("q", "quit", "exit", show=False), Binding("ctrl+c", "quit", show=False, priority=True)]

        def __init__(self, history_runs: list[StatsRun]):
            super().__init__()
            self.history_runs = history_runs
            self.page_idx = 0
            self.range_idx = 0

        def compose(self) -> ComposeResult:
            yield Static(id="stats")

        def on_mount(self) -> None:
            self.set_interval(0.1, self.exit_if_interrupted)
            self.refresh_dashboard()

        def on_resize(self) -> None:
            self.refresh_dashboard()

        def on_key(self, event) -> None:
            if event.key == "right":
                event.prevent_default()
                self.action_next_page()
            elif event.key == "left":
                event.prevent_default()
                self.action_previous_page()
            elif event.key == "down":
                event.prevent_default()
                self.action_next_range()
            elif event.key == "up":
                event.prevent_default()
                self.action_previous_range()
            elif event.key == "ctrl+c":
                event.prevent_default()
                self.exit()

        def exit_if_interrupted(self) -> None:
            if interrupt_requested():
                self.exit()

        def action_previous_page(self) -> None:
            self.page_idx = (self.page_idx - 1) % len(STATS_PAGES)
            self.refresh_dashboard()

        def action_next_page(self) -> None:
            self.page_idx = (self.page_idx + 1) % len(STATS_PAGES)
            self.refresh_dashboard()

        def action_previous_range(self) -> None:
            self.range_idx = (self.range_idx - 1) % len(STATS_RANGES)
            self.refresh_dashboard()

        def action_next_range(self) -> None:
            self.range_idx = (self.range_idx + 1) % len(STATS_RANGES)
            self.refresh_dashboard()

        def selected_runs(self) -> list[StatsRun]:
            return filter_stats_runs(self.history_runs, STATS_RANGES[self.range_idx][0])

        def tabs(self):
            text = Text()
            for idx, page in enumerate(STATS_PAGES):
                style = f"bold black on {STATS_ACCENT}" if idx == self.page_idx else "dim"
                text.append(f" {page} ", style=style)
                text.append("  ")
            text.append("    ")
            for idx, (label, _days) in enumerate(STATS_RANGES):
                style = f"bold black on {STATS_ACCENT}" if idx == self.range_idx else "dim"
                text.append(f" {label} ", style=style)
                text.append("  ")
            return text

        def footer_text(self):
            return Text("←/→ pages · ↑/↓ range · q exit", style="dim")

        def panel(self, renderable, title: str):
            return Panel(renderable, title=title, border_style=STATS_ACCENT_MUTED, padding=(0, 1))

        def metric(self, label: str, value: str, style: str = "white"):
            return Text.assemble((f"{label}: ", "dim"), (value, style))

        def metric_table(self, left: list[tuple[str, str, str]], right: list[tuple[str, str, str]]):
            table = Table.grid(expand=True)
            table.add_column(ratio=1)
            table.add_column(ratio=1)
            for idx in range(max(len(left), len(right))):
                lhs = self.metric(*left[idx]) if idx < len(left) else ""
                rhs = self.metric(*right[idx]) if idx < len(right) else ""
                table.add_row(lhs, rhs)
            return table

        def heatmap_cell(self, count: int, max_count: int) -> tuple[str, str]:
            if count <= 0 or max_count <= 0:
                return "·", "dim"
            level = max(1, min(4, ((count * 4) + max_count - 1) // max_count))
            return ("░", "▒", "▓", "█")[level - 1], STATS_HEATMAP_STYLES[level - 1]

        def heatmap(self):
            if not self.history_runs:
                return self.panel(Text("No runs in history", style="dim"), "Run Count")
            counts = heatmap_counts(self.history_runs)
            today = datetime.now().astimezone().date()
            last_day = max(counts) if counts else today
            end = max(today, last_day)
            end = end + timedelta(days=6 - end.weekday())
            available_width = max(20, self.size.width - 8)
            max_weeks = max(1, (available_width - 6) // 2)
            weeks = max_weeks
            start = end - timedelta(days=(weeks * 7) - 1)
            max_count = max(counts.values(), default=0)
            out = Text()
            out.append("      ", style="dim")
            for week in range(weeks):
                day = start + timedelta(days=week * 7)
                label = day.strftime("%b")[:2] if day.day <= 7 or week == 0 else "  "
                out.append(label.ljust(2), style="dim")
            out.append("\n")
            for weekday, name in enumerate(("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")):
                out.append(f"{name}   ", style="dim")
                for week in range(weeks):
                    day = start + timedelta(days=(week * 7) + weekday)
                    char, style = self.heatmap_cell(counts.get(day, 0), max_count)
                    out.append(char, style=style)
                    out.append(" ")
                out.append("\n")
            out.append("Less  ", style="dim")
            for count in (0, 1, 2, 3, 4):
                char, style = self.heatmap_cell(count, 4)
                out.append(char, style=style)
                out.append(" ")
            out.append(" More", style="dim")
            return self.panel(out, "Run Count")

        def overview(self, runs_for_range: list[StatsRun], _label: str):
            if not runs_for_range:
                return Group(self.heatmap(), self.panel(Text("No runs in this range", style="dim"), "Summary"))
            total = total_elapsed(runs_for_range)
            avg = total / len(runs_for_range)
            run_counts = run_status_counts(runs_for_range)
            step_counts = step_status_counts(runs_for_range)
            steps = aggregate_step_stats(runs_for_range)
            latest = runs_for_range[-1]
            slowest_run = max(runs_for_range, key=lambda run: run.elapsed)
            slowest = steps[0] if steps else None
            left = [("Runs", str(len(runs_for_range)), "white"), ("Active days", str(active_day_count(runs_for_range)), "white"), ("Total time", format_stats_duration(total), "white"), ("Average run", format_stats_duration(avg), "white"), ("Latest", f"{latest.status} {format_stats_duration(latest.elapsed)}", stats_status_style(latest.status))]
            right = [("Completed", str(run_counts.get("completed", 0)), stats_status_style("completed")), ("Interrupted", str(run_counts.get("interrupted", 0)), stats_status_style("interrupted")), ("Failed", str(run_counts.get("failed", 0)), stats_status_style("failed")), ("Steps ok/skip/fail", f"{step_counts['ok']}/{step_counts['skip']}/{step_counts['fail']}", "white"), ("Slowest run", format_stats_duration(slowest_run.elapsed), "white")]
            panels = [self.heatmap(), self.panel(self.metric_table(left, right), "Summary")]
            if slowest:
                panels.append(self.panel(self.metric("Slowest avg step", f"{slowest.section}/{slowest.name} {format_stats_duration(step_average(slowest))}", STATS_ACCENT), "Highlight"))
            return Group(*panels)

        def steps(self, runs_for_range: list[StatsRun]):
            steps = [step for step in aggregate_step_stats(runs_for_range) if step.timed]
            if not steps:
                return self.panel(Text("No timed successful steps in this range", style="dim"), "Steps")
            max_avg = max(step_average(step) for step in steps)
            table = Table(title="Average Duration By Step", title_style=STATS_ACCENT, border_style=STATS_ACCENT_MUTED, expand=True, show_lines=False)
            table.add_column("#", justify="right", style="dim", width=3)
            table.add_column("Step", overflow="fold")
            table.add_column("Avg", justify="right")
            table.add_column("Total", justify="right")
            table.add_column("ok/skip/fail", justify="right")
            table.add_column("Trend", ratio=1)
            for idx, step in enumerate(steps[:18], start=1):
                avg = step_average(step)
                table.add_row(str(idx), f"{step.section}/{step.name}", format_stats_duration(avg), format_stats_duration(step.total_elapsed), f"{step.ok}/{step.skip}/{step.fail}", Text(stats_bar_text(avg, max_avg, 24), style=STATS_ACCENT))
            return table

        def runs_summary(self, runs_for_range: list[StatsRun]):
            counts = run_status_counts(runs_for_range)
            total = total_elapsed(runs_for_range)
            avg = total / len(runs_for_range)
            slowest = max(runs_for_range, key=lambda run: run.elapsed)
            fastest = min(runs_for_range, key=lambda run: run.elapsed)
            latest = runs_for_range[-1]
            left = [("Runs", str(len(runs_for_range)), "white"), ("Total time", format_stats_duration(total), "white"), ("Average", format_stats_duration(avg), "white"), ("Latest", f"{latest.started_at:%b %d %H:%M} {latest.status}", stats_status_style(latest.status))]
            right = [("Completed", str(counts.get("completed", 0)), stats_status_style("completed")), ("Interrupted", str(counts.get("interrupted", 0)), stats_status_style("interrupted")), ("Failed", str(counts.get("failed", 0)), stats_status_style("failed")), ("Fast/slow", f"{format_stats_duration(fastest.elapsed)} / {format_stats_duration(slowest.elapsed)}", "white")]
            return self.panel(self.metric_table(left, right), "Summary")

        def runs_graph_header(self, width: int):
            title = "Run Timeline"
            left_pad = 4
            title_start = max(left_pad, (width - len(title)) // 2)
            out = Text(" " * left_pad)
            out.append("█ ", style=stats_status_style("completed"))
            out.append("completed  ", style="dim")
            out.append("█ ", style=stats_status_style("interrupted"))
            out.append("interrupted  ", style="dim")
            out.append("█ ", style=stats_status_style("failed"))
            out.append("failed", style="dim")
            if out.cell_len < title_start:
                out.append(" " * (title_start - out.cell_len))
                out.append(title, style=f"bold {STATS_ACCENT}")
            else:
                out.append("  ")
                out.append(title, style=f"bold {STATS_ACCENT}")
            return out

        def runs_page(self, runs_for_range: list[StatsRun]):
            if not runs_for_range:
                return self.panel(Text("No runs in this range", style="dim"), "Runs")
            width = max(60, self.size.width - 6)
            height = max(10, min(18, self.size.height - 16))
            chart = Text.from_ansi(plotext_runs_chart(runs_for_range, width, height))
            return Group(self.runs_graph_header(width), chart, self.runs_summary(runs_for_range))

        def render_dashboard(self):
            if self.size.width < STATS_MIN_COLUMNS or self.size.height < STATS_MIN_ROWS:
                message = Text.assemble(("Terminal too small for stats\n", "bold yellow"), (f"Need at least {STATS_MIN_COLUMNS}x{STATS_MIN_ROWS}, current {self.size.width}x{self.size.height}.\n", "dim"), ("Press q to exit.", "dim"))
                return self.panel(message, "System Update Stats")
            label = STATS_RANGES[self.range_idx][0]
            runs_for_range = self.selected_runs()
            title = Text.assemble(("System Update Stats", f"bold {STATS_ACCENT}"), (f"  {datetime.now():%a %d %b %Y  %H:%M}", "dim"))
            if self.page_idx == 0:
                page = self.overview(runs_for_range, label)
            elif self.page_idx == 1:
                page = self.steps(runs_for_range)
            else:
                page = self.runs_page(runs_for_range)
            return Group(title, self.tabs(), Text(" "), page, self.footer_text())

        def refresh_dashboard(self) -> None:
            self.query_one("#stats", Static).update(self.render_dashboard())

    StatsApp(runs).run()
    return 0

def run_stats_mode(_steps: list[Step]) -> int:
    """Run stats mode under the normal updater lock."""
    lock_file = acquire_lock()
    try:
        runs = stats_runs_from_history(read_history())
        if not runs:
            write("No update history yet\n")
            return 0
        if IS_TTY and sys.stdin.isatty():
            return run_stats_tui(runs)
        return print_stats_plain(runs)
    finally:
        lock_file.close()

def shell_inner_command(words: list[str]) -> str | None:
    """Return the command string passed to a shell wrapper's -c option."""
    if not words or Path(words[0]).name not in {"bash", "sh", "zsh", "fish"}:
        return None
    for idx, word in enumerate(words[:-1]):
        if word == "-c":
            return words[idx + 1]
    return None

def command_uses_sudo(cmd: str) -> bool:
    """Return whether a command appears to invoke sudo directly or via shell."""
    words = split_command_words(cmd)
    if words and words[0] == "sudo":
        return True
    if inner := shell_inner_command(words):
        return command_uses_sudo(inner)
    return bool(re.search(r"(^|[\s;&|('\"`])sudo\s+", cmd))

def steps_need_sudo(steps: list[Step]) -> bool:
    """Return whether any selected step command appears to need sudo."""
    return any(command_uses_sudo(cmd) for step in steps for cmd in step.commands)

def sudo_noninteractive_available(env: dict) -> bool:
    """Return whether sudo can run a no-op without prompting."""
    result = run_shell_command("sudo -n true", env, capture_output=True, timeout=PROBE_TIMEOUT)
    raise_if_interrupted(result)
    return result.returncode == 0

def sudo_interactive_validate(env: dict) -> bool:
    """Refresh sudo credentials interactively when passwordless sudo is unavailable."""
    sudo_path = shutil.which("sudo")
    if sudo_path is None:
        return False
    try:
        return subprocess.run([sudo_path, "-v"], env=env).returncode == 0  # nosec B603
    except FileNotFoundError:
        return False

def run_sudo_preflight(steps: list[Step], env: dict, *, noninteractive: bool = False) -> bool:
    """Validate sudo credentials when selected commands require sudo."""
    if not steps_need_sudo(steps):
        return True
    if sudo_noninteractive_available(env):
        return True
    return False if noninteractive else sudo_interactive_validate(env)

def available_lock_pid_lines(pid: str) -> list[str]:
    """Return diagnostic lines for PID text in an otherwise available lock."""
    if not pid:
        return []
    proc = Path(f"/proc/{pid}")
    if proc.exists():
        return [f"previous pid in lock file: {pid} running, but lock is available"]
    return [f"stale-looking pid in lock file: {pid} not running (harmless)"]

def held_lock_pid_lines(pid: str) -> list[str]:
    """Return diagnostic lines for PID text in a held lock."""
    if not pid:
        return []
    proc = Path(f"/proc/{pid}")
    lines = [f"pid: {pid} {'running' if proc.exists() else 'not found'}"]
    cmdline = proc / "cmdline"
    try:
        if cmdline.exists():
            lines.append("cmd: " + cmdline.read_text().replace("\0", " ").strip())
    except OSError:
        pass
    return lines

def lock_diagnostics() -> tuple[bool, list[str]]:
    """Return lock availability and human-readable diagnostic lines."""
    lock_file = open_private_lock_file()
    try:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        lock_file.seek(0)
        pid = lock_file.read().strip()
        lines = [f"lock available: {LOCK_PATH}"]
        lines.extend(available_lock_pid_lines(pid))
        return True, lines
    except BlockingIOError:
        lock_file.seek(0)
        pid = lock_file.read().strip()
        lines = [f"lock held: {LOCK_PATH}"]
        lines.extend(held_lock_pid_lines(pid))
        return False, lines
    finally:
        lock_file.close()

def report(kind: str, message: str) -> None:
    """Print one report-mode line."""
    colors = {"ok": GREEN, "warn": YELLOW, "fail": RED, "info": GRAY}
    write("  ", colors.get(kind, GRAY), kind, RESET, "  ", message, "\n")

def needs_label(step: Step) -> str:
    """Return a compact label describing explicit or inferred needs."""
    source = "explicit" if step.needs_explicit else "inferred"
    return f"{source} {', '.join(step.requires) if step.requires else 'none'}"

def static_step_problem(step: Step) -> str | None:
    """Return the first static requirement problem for a step."""
    for need in step.requires:
        if reason := missing_requirement(need):
            return reason
    return None

def print_dry_run(all_steps: list[Step], selected_steps: list[Step], args: CliArgs) -> int:
    """Print selected steps and static skips without running update commands."""
    selected_names = {step.name for step in selected_steps}
    report("info", f"selected {len(selected_steps)} steps")
    for step in all_steps:
        if step.name not in selected_names:
            report("info", f"filtered: {step.name} ({filter_reason(step, args) or 'not selected'})")
            continue
        problem = static_step_problem(step)
        if problem:
            report("warn", f"missing need: {step.name} ({problem})")
        elif step.skip_if:
            report("warn", f"would skip: {step.name} (skip_if configured, not evaluated)")
        else:
            report("ok", f"would run: {step.name} (needs: {needs_label(step)})")
    if steps_need_sudo(selected_steps):
        report("info", "sudo required by selected steps")
    return 0

def print_list_steps(selected_steps: list[Step]) -> int:
    """Print selected step names grouped by config section."""
    current_group = None
    for step in selected_steps:
        if step.group != current_group:
            current_group = step.group
            write(SECTION_COLOR, current_group, RESET, "\n")
        write("  ", step.name, "\n")
    return 0

def duplicate_step_names(steps: list[Step]) -> list[str]:
    """Return duplicate step names from parsed config."""
    seen: set[str] = set()
    dupes: list[str] = []
    for step in steps:
        if step.name in seen and step.name not in dupes:
            dupes.append(step.name)
        seen.add(step.name)
    return dupes

def stat_commands(step: Step) -> list[str]:
    """Return all stat commands configured for a step."""
    commands = list(step.stats_before.values()) + list(step.stats_after.values())
    if step.version_cmd:
        commands.append(step.version_cmd)
    return commands

def report_lock_status(fail_when_locked: bool) -> bool:
    """Report lock diagnostics and return whether the lock state is acceptable."""
    lock_ok, lines = lock_diagnostics()
    kind = "fail" if fail_when_locked and not lock_ok else "warn"
    for line in lines:
        line_kind = "warn" if lock_ok and ("stale-looking" in line or "previous pid" in line) else "ok"
        report(line_kind if lock_ok else kind, line)
    return lock_ok or not fail_when_locked

def report_empty_sections() -> None:
    """Report empty YAML sections found during the last config load."""
    for section in empty_config_sections():
        report("warn", f"empty section: {section}")

def report_static_step_problems(steps: list[Step]) -> bool:
    """Report missing explicit or inferred needs and return failure state."""
    failed = False
    for step in steps:
        if problem := static_step_problem(step):
            report("fail", f"{step.name}: {problem}")
            failed = True
    return failed

def report_skip_if(step: Step, env: dict) -> None:
    """Run and report one skip_if probe for test-config mode."""
    if not step.skip_if:
        return
    result = run_shell_command(step.skip_if, env, timeout=PROBE_TIMEOUT)
    raise_if_interrupted(result)
    status = "timeout" if result.timed_out else f"exit {result.returncode}"
    report("warn" if result.timed_out else "ok", f"{step.name}: skip_if {status}")

def report_stat_commands(step: Step, env: dict) -> None:
    """Run and report stat probes for test-config mode."""
    for cmd in stat_commands(step):
        result = run_shell_command(cmd, env, capture_output=True, timeout=STAT_TIMEOUT)
        raise_if_interrupted(result)
        kind = "warn" if result.timed_out or result.returncode != 0 else "ok"
        status = "timeout" if result.timed_out else f"exit {result.returncode}"
        report(kind, f"{step.name}: stat {status}")

def is_gearlever_step(step: Step) -> bool:
    """Return whether a step config appears to manage Gear Lever AppImages."""
    text = "\n".join([step.name, *step.commands, step.skip_if]).lower()
    return "gearlever" in text or "it.mijorus.gearlever" in text

def report_gearlever_presence(step: Step, env: dict) -> None:
    """Report Gear Lever Flatpak presence for Gear Lever-related steps."""
    if not is_gearlever_step(step):
        return
    if shutil.which("flatpak") is None:
        report("warn", f"{step.name}: Gear Lever check skipped, flatpak not found")
        return
    result = run_shell_command("flatpak info it.mijorus.gearlever", env, timeout=PROBE_TIMEOUT)
    raise_if_interrupted(result)
    report("ok" if result.returncode == 0 else "warn", f"{step.name}: Gear Lever Flatpak {'present' if result.returncode == 0 else 'not present'}")

def report_test_config_step(step: Step, env: dict) -> bool:
    """Report all diagnostics for one step and return failure state."""
    report("info", f"{step.name}: needs {needs_label(step)}")
    failed = static_step_problem(step) is not None
    if failed:
        report("fail", f"{step.name}: {static_step_problem(step)}")
    report_skip_if(step, env)
    report_stat_commands(step, env)
    report_gearlever_presence(step, env)
    return failed

def report_sudo_status(steps: list[Step], env: dict, *, check_auth: bool) -> bool:
    """Report sudo requirement or credential availability."""
    if not steps_need_sudo(steps):
        report("ok", "sudo not required")
        return True
    if not check_auth:
        report("warn", "sudo required")
        return True
    sudo_ok = run_sudo_preflight(steps, env, noninteractive=True)
    report("ok" if sudo_ok else "fail", "sudo available" if sudo_ok else "sudo unavailable without password")
    return sudo_ok

def report_network_status(env: dict, *, fail: bool) -> bool:
    """Report network readiness and return whether it is acceptable."""
    ok = not network_check_enabled(env) or network_up(endpoints=network_endpoints(env))
    good = "network ready" if fail else "network reachable"
    bad = "network unavailable" if fail else "network not reachable"
    report("ok" if ok else ("fail" if fail else "warn"), good if ok else bad)
    return ok or not fail

def print_test_config(steps: list[Step], env: dict) -> int:
    """Run full config diagnostics without update commands."""
    failed = False
    report_lock_status(fail_when_locked=False)
    report_empty_sections()
    report("ok", f"loaded {len(steps)} steps")
    for step in steps:
        failed = report_test_config_step(step, env) or failed
    report_sudo_status(steps, env, check_auth=False)
    report_network_status(env, fail=False)
    report("fail" if failed else "ok", "test-config failed" if failed else "test-config passed")
    return 1 if failed else 0

def report_self_test_status() -> bool:
    """Run self-tests and return whether they passed."""
    return run_self_tests()

def print_check(steps: list[Step], env: dict) -> int:
    """Run quick readiness checks without update commands or stats."""
    checks = [
        report_self_test_status(),
        report_lock_status(fail_when_locked=True),
        report_network_status(env, fail=True),
        not report_static_step_problems(steps),
        report_sudo_status(steps, env, check_auth=True),
    ]
    failed = not all(checks)
    report("fail" if failed else "ok", "check failed" if failed else "check passed")
    return 1 if failed else 0

