def print_summary(results: list[Result], total: float, estimate: float | None = None) -> None:
    """Print the compact final summary line."""
    total_steps = len(results)
    lines = [gray_rule(), summary_status(results, total_steps, total, estimate)]
    if IS_TTY:
        write(MAIN_UI.move_up(1), render_cleared_lines(lines), "\n")
    else:
        write("\n".join(lines), "\n")

