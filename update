# ── Main ──────────────────────────────────────────────────────────────────────

def selected_steps_for_args(args: CliArgs) -> tuple[list[Step], list[Step]]:
    """Load config, apply filters, and reject empty selections."""
    all_steps = load_config(CONFIG_PATH)
    if args.stats:
        return all_steps, all_steps
    selected = filter_steps(all_steps, args)
    if not selected:
        config_error("No steps selected")
    return all_steps, selected

def run_report_mode(args: CliArgs, all_steps: list[Step], selected_steps: list[Step], env: dict) -> int | None:
    """Run a non-update mode and return its exit code, or None for normal mode."""
    if args.stats:
        return run_stats_mode(all_steps)
    if args.dry_run:
        return print_dry_run(all_steps, selected_steps, args)
    if args.list_steps:
        return print_list_steps(selected_steps)
    if args.check:
        return print_check(selected_steps, env)
    if args.test_config:
        return print_test_config(selected_steps, env)
    return None

def run_normal_update(steps: list[Step], env: dict) -> int:
    """Run the selected update steps and return the final process exit code."""
    lock_file = acquire_lock()
    try:
        wait_for_network()
        if not run_sudo_preflight(steps, env):
            config_error("sudo preflight failed")
        history = read_history()
        estimate = estimate_total_duration(steps, history)
        live_estimate = estimate_complete_total_duration(steps, history)
        write(BOLD, TITLE_COLOR, "  System Update", RESET,
              GRAY, f"  {datetime.now():%a %d %b %Y  %H:%M}\n", RESET)
        write(GRAY, rule_line(), RESET)
        started_at = datetime.now().astimezone()
        t_start = time.monotonic()
        try:
            results = run_all(steps, t_start, live_estimate)
        except RunInterrupted as e:
            record_history(e.results, started_at, datetime.now().astimezone(), time.monotonic() - t_start, status="interrupted")
            raise
        elapsed = time.monotonic() - t_start
        record_history(results, started_at, datetime.now().astimezone(), elapsed)
        print_summary(results, elapsed, estimate)
        return 1 if any(r.status == "fail" for r in results) else 0
    finally:
        lock_file.close()

def main() -> None:
    """Program entrypoint for the updater CLI."""
    args = parse_cli_args(sys.argv[1:])

    if args.self_test:
        sys.exit(0 if run_self_tests() else 1)

    previous_sigint = signal.getsignal(signal.SIGINT)
    clear_interrupt_request()
    signal.signal(signal.SIGINT, handle_sigint)
    try:
        all_steps, selected_steps = selected_steps_for_args(args)
        env = build_run_env(str(STATE_DIR / "check-tmp"))
        mode_result = run_report_mode(args, all_steps, selected_steps, env)
        sys.exit(mode_result if mode_result is not None else run_normal_update(selected_steps, env))
    except (KeyboardInterrupt, UserInterrupt):
        stop_active_spinner()
        write(LINE_CLEAR, YELLOW, "Interrupted\n", RESET)
        sys.exit(130)
    finally:
        signal.signal(signal.SIGINT, previous_sigint)

if __name__ == "__main__":
    main()
