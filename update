def build_run_env(tmpdir: str) -> dict:
    """Build the child environment with noninteractive mode and UPDATE_TMPDIR."""
    return {**os.environ, "DEBIAN_FRONTEND": "noninteractive", "UPDATE_TMPDIR": tmpdir}

def stats_column(steps: list[Step]) -> int:
    """Return the shared display column where stats begin."""
    return max((len(prefix_plain(step.name)) for step in steps), default=0) + 3

def next_section_heading(step: Step, current_section: str | None) -> tuple[str | None, str]:
    """Return updated section state and optional heading text."""
    if step.section and step.section != current_section:
        return step.section, step.section
    return current_section, ""

def collect_pre_texts(step: Step, env: dict) -> tuple[list[str], str | None]:
    """Collect before-stat text and optional pre-update version value."""
    pre_vals = run_stats(step.stats_before, env)
    pre_version = run_stat_cmd(step.version_cmd, env) if step.version_cmd else None
    texts = [pre_version] if pre_version is not None else build_before_stat_texts(pre_vals)
    return texts, pre_version

def collect_after_parts(step: Step, env: dict, pre_version: str | None) -> list[tuple[str, str]]:
    """Collect after-stat parts and version transition display parts."""
    after_parts = build_after_stat_parts(run_stats(step.stats_after, env))
    if not step.version_cmd:
        return after_parts
    post_version = run_stat_cmd(step.version_cmd, env)
    if post_version is None:
        return after_parts
    if pre_version is None:
        after_parts.append(("dot", post_version))
    elif post_version != pre_version:
        after_parts.append(("transition", post_version))
    else:
        after_parts.append(("append", "unchanged"))
    return after_parts

def start_step_spinner(step: Step, stats_col: int, pre_texts: list[str], t0: float,
                       progress: ProgressState | None, section_heading: str = "") -> None:
    """Start the TTY live spinner for one update step."""
    line_count = 3 if progress is not None else 1
    spinner = Spinner(lambda frame: live_step_block(
        step.name, stats_col, pre_texts, progress, icon=frame, elapsed=time.monotonic() - t0
    ), line_count=line_count, clear_on_stop=progress is None)
    if IS_TTY:
        prefix = MAIN_UI.move_up(1) if progress is not None and progress.results else ""
        lines = []
        if section_heading:
            lines.append(section_heading_line(section_heading))
        lines.extend(live_step_block(step.name, stats_col, pre_texts, progress, elapsed=0.0).split("\n"))
        write(prefix, render_cleared_lines(lines))
        spinner.start()
        set_active_spinner(spinner)
    elif section_heading:
        write(section_heading_line(section_heading), "\n")

def execute_step_commands(step: Step, env: dict, log_dir: Path) -> CommandOutcome:
    """Run all shell commands for one step and return structured outcome."""
    for idx, cmd in enumerate(step.commands):
        temp_log_path = command_log_temp_path(log_dir, idx)
        final_log_path: Path | None = None
        display_name = step.name if len(step.commands) == 1 else None
        try:
            with open_private_log_file(temp_log_path) as log_file:
                write_command_log_header(log_file, cmd)
                result = run_shell_command(cmd, env, log_file=log_file, protect_on_interrupt=True)
                log_file.flush()
                final_log_path = finalize_command_log(temp_log_path, log_dir, cmd, command_log_status(result), display_name)
                if result.interrupted:
                    raise UserInterrupt()
                if result.returncode != 0:
                    failure = build_fail_info(step.name, cmd, result.returncode or 1, log_file, final_log_path)
                    return CommandOutcome(True, failure, interrupt_requested())
        except UserInterrupt:
            raise
        except Exception as e:
            if final_log_path is None and temp_log_path.exists():
                final_log_path = finalize_command_log(temp_log_path, log_dir, cmd, "failed", display_name)
            return CommandOutcome(True, build_exception_fail_info(step.name, cmd, e, final_log_path), interrupt_requested())
        if interrupt_requested():
            return CommandOutcome(interrupted=True)
    return CommandOutcome(interrupted=interrupt_requested())

def render_skip(step: Step, reason: str, stats_col: int, progress: ProgressState | None = None,
                section_heading: str = "") -> StepOutcome:
    """Render and return a skipped-step outcome."""
    result = Result(step.name, "skip", reason, group=step.group)
    skip_text = skip_line(step.name, reason, stats_col)
    if IS_TTY and progress is not None:
        final_progress = completed_progress(progress, result)
        prefix = MAIN_UI.move_up(1) if progress.results else ""
        lines = []
        if section_heading:
            lines.append(section_heading_line(section_heading))
        lines.append(skip_text)
        lines.extend(progress_footer(final_progress).split("\n"))
        write(prefix, render_cleared_lines(lines))
    else:
        if section_heading:
            write(section_heading_line(section_heading), "\n")
        write(skip_text, "\n")
    return StepOutcome(result)

def render_step_result(step: Step, elapsed: float, stats_col: int, pre_texts: list[str],
                       after_parts: list[tuple[str, str]], outcome: CommandOutcome,
                       progress: ProgressState | None = None) -> StepOutcome:
    """Render a completed step and convert command outcome to step outcome."""
    if outcome.failed:
        failure = outcome.failure or FailureInfo("error", "missing failure details")
        result = Result(step.name, "fail", failure.reason, elapsed, step.group)
        block = failure_block(step.name, elapsed, stats_col, failure)
    else:
        result = Result(step.name, "ok", elapsed=elapsed, group=step.group)
        block = final_line("✓", GREEN, step.name, elapsed, stats_col, pre_texts, after_parts)
    if IS_TTY and progress is not None:
        final_progress = completed_progress(progress, result)
        lines = block.split("\n") + progress_footer(final_progress).split("\n")
        write(MAIN_UI.move_up(2), render_cleared_lines(lines))
    else:
        write(LINE_CLEAR, block, "\n")
    return StepOutcome(result, outcome.interrupted)

def run_step(step: Step, env: dict, stats_col: int, log_dir: Path,
             progress: ProgressState | None = None, section_heading: str = "") -> StepOutcome:
    """Run one step end-to-end, including stats and terminal rendering."""
    if reason := skip_reason(step, env):
        return render_skip(step, reason, stats_col, progress, section_heading)
    if interrupt_requested():
        raise UserInterrupt()
    pre_texts, pre_version = collect_pre_texts(step, env)
    if interrupt_requested():
        raise UserInterrupt()

    t0 = time.monotonic()
    start_step_spinner(step, stats_col, pre_texts, t0, progress, section_heading)
    try:
        outcome = execute_step_commands(step, env, log_dir)
    finally:
        elapsed = time.monotonic() - t0
        stop_active_spinner()

    after_parts = [] if outcome.failed or outcome.interrupted else collect_after_parts(step, env, pre_version)
    return render_step_result(step, elapsed, stats_col, pre_texts, after_parts, outcome, progress)

def run_all(steps: list[Step], run_start: float, total_estimate: float | None) -> list[Result]:
    """Run all configured steps within one private temporary directory."""
    results: list[Result] = []
    current_section = None
    # Config commands parse their own output via UPDATE_TMPDIR. Keeping this
    # directory private per run avoids predictable /tmp file clobbering.
    with tempfile.TemporaryDirectory(prefix="update-") as tmpdir:
        env = build_run_env(tmpdir)
        log_dir = create_log_dir()
        stat_col = stats_column(steps)
        try:
            total_steps = len(steps)
            for idx, step in enumerate(steps, start=1):
                current_section, section_heading = next_section_heading(step, current_section)
                progress = ProgressState(idx, total_steps, run_start, results, total_estimate)
                outcome = run_step(step, env, stat_col, log_dir, progress, section_heading)
                results.append(outcome.result)
                if outcome.interrupted:
                    raise RunInterrupted(results)
        except RunInterrupted:
            raise
        except UserInterrupt as e:
            raise RunInterrupted(results) from e
    return results

