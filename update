RESET = "\033[0m"; BOLD = "\033[1m"
IS_TTY = sys.stdout.isatty()

class MainTerminalUI:
    """Rich-backed terminal primitive layer for the normal update UI."""

    def __init__(self):
        self.console = Console(
            file=sys.stdout,
            force_terminal=IS_TTY,
            color_system="256" if IS_TTY else None,
            legacy_windows=False,
            highlight=False,
            soft_wrap=True,
        )

    def write(self, *parts: str) -> None:
        """Write already-rendered text without Rich markup processing."""
        self.console.file.write("".join(parts))
        self.console.file.flush()

    def control_text(self, *codes) -> str:
        """Return an ANSI control string generated by Rich."""
        return Control(*codes).segment.text if IS_TTY else ""

    def erase_line(self) -> str:
        """Return a clear-current-line control string."""
        return self.control_text((ControlType.ERASE_IN_LINE, 2))

    def carriage_return(self) -> str:
        """Return a carriage-return control string."""
        return self.control_text(ControlType.CARRIAGE_RETURN)

    def move_up(self, count: int) -> str:
        """Return a previous-line control string."""
        return self.control_text((ControlType.CURSOR_UP, count), (ControlType.CURSOR_MOVE_TO_COLUMN, 0)) if count > 0 else ""

    def terminal_width(self, default: int = 100) -> int:
        """Return the active terminal width using Rich's console state."""
        try:
            return self.console.size.width
        except Exception:
            return default

