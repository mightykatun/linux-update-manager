HEADER_FAMILIES = ("red", "orange", "yellow", "green", "cyan", "blue", "purple", "pink")

@dataclass(frozen=True)
class HeaderColor:
    """Precomputed color metrics used to build readable random headers."""

    code: int
    hue: float
    saturation: float
    value: float
    luminance: float
    chroma: int

def xterm_rgb(n: int) -> tuple[int, int, int]:
    """Convert an xterm-256 color code to an RGB tuple."""
    if n < 16:
        table = [
            (0, 0, 0), (128, 0, 0), (0, 128, 0), (128, 128, 0),
            (0, 0, 128), (128, 0, 128), (0, 128, 128), (192, 192, 192),
            (128, 128, 128), (255, 0, 0), (0, 255, 0), (255, 255, 0),
            (0, 0, 255), (255, 0, 255), (0, 255, 255), (255, 255, 255),
        ]
        return table[n]
    if n < 232:
        n -= 16
        levels = [0, 95, 135, 175, 215, 255]
        return levels[n // 36], levels[(n % 36) // 6], levels[n % 6]
    gray = 8 + (n - 232) * 10
    return gray, gray, gray

def luminance(rgb: tuple[int, int, int]) -> float:
    """Return perceived luminance for an RGB color."""
    r, g, b = rgb
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def chroma(rgb: tuple[int, int, int]) -> int:
    """Return max-minus-min channel spread for an RGB color."""
    return max(rgb) - min(rgb)

def hue_distance(a: float, b: float) -> float:
    """Return circular hue distance in HSV hue units."""
    diff = abs(a - b)
    return min(diff, 1.0 - diff)

def build_header_color(code: int) -> HeaderColor:
    """Build a HeaderColor record for an xterm-256 color code."""
    rgb = xterm_rgb(code)
    hue, sat, val = colorsys.rgb_to_hsv(*(channel / 255 for channel in rgb))
    return HeaderColor(
        code=code,
        hue=hue,
        saturation=sat,
        value=val,
        luminance=luminance(rgb),
        chroma=chroma(rgb),
    )

def build_header_palette() -> list[HeaderColor]:
    """Build the xterm color candidates used for randomized headers."""
    return [build_header_color(code) for code in range(16, 232)]

def is_title_color(color: HeaderColor) -> bool:
    """Return whether a color is bright enough for the main title."""
    return (
        color.saturation >= 0.45
        and color.value >= 0.75
        and color.luminance >= 140
        and color.chroma >= 80
    )

def is_section_color(color: HeaderColor) -> bool:
    """Return whether a color is readable for section headings."""
    return (
        color.saturation >= 0.35
        and color.value >= 0.45
        and color.luminance >= 85
        and color.chroma >= 60
    )

def header_family(hue: float) -> str:
    """Map a hue to a broad family for balanced random selection."""
    idx = int((((hue + (1 / 16)) % 1.0) * len(HEADER_FAMILIES)))
    return HEADER_FAMILIES[idx]

def is_header_pair(title: HeaderColor, section: HeaderColor) -> bool:
    """Return whether title and section colors are a readable pair."""
    if title.code == section.code:
        return False
    if hue_distance(title.hue, section.hue) > 0.08:
        return False

    contrast = title.luminance - section.luminance
    value_gap = title.value - section.value
    if contrast < 18 or contrast > 65:
        return False
    if value_gap < 0.08 or value_gap > 0.30:
        return False
    if section.saturation > title.saturation + 0.15:
        return False
    return True

def generated_header_pair_groups() -> dict[str, list[tuple[int, int]]]:
    """Group valid title/section color pairs by hue family."""
    palette = build_header_palette()
    title_colors = [color for color in palette if is_title_color(color)]
    section_colors = [color for color in palette if is_section_color(color)]
    groups = {family: [] for family in HEADER_FAMILIES}

    for title in title_colors:
        family = header_family(title.hue)
        for section in section_colors:
            if is_header_pair(title, section):
                groups[family].append((title.code, section.code))

    return groups

def choose_header_color_codes(groups: dict[str, list[tuple[int, int]]]) -> tuple[int, int]:
    """Choose a balanced random title/section xterm color pair."""
    non_empty_groups = [pairs for pairs in groups.values() if pairs]
    if not non_empty_groups:
        return 15, 242
    # Cosmetic color selection only; this is not security-sensitive randomness.
    return random.choice(random.choice(non_empty_groups))  # nosec B311

def rgb_hex(rgb: tuple[int, int, int]) -> str:
    """Return #rrggbb text for an RGB tuple."""
    return "#%02x%02x%02x" % rgb

def blend_rgb(a: tuple[int, int, int], b: tuple[int, int, int], amount: float) -> tuple[int, int, int]:
    """Blend two RGB colors by amount from a to b."""
    amount = max(0.0, min(1.0, amount))
    return tuple(round(x + ((y - x) * amount)) for x, y in zip(a, b))

